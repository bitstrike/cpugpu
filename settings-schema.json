{
    "graph-width": {
        "type": "spinbutton",
        "default": 150,
        "min": 50,
        "max": 500,
        "step": 10,
        "units": "pixels",
        "description": "Graph Width",
        "tooltip": "Width of each temperature graph"
    },
    "override-panel-height": {
        "type": "checkbox",
        "default": false,
        "description": "Override Panel Height",
        "tooltip": "Enable to manually set graph height, otherwise graphs automatically fit panel height"
    },
    "graph-height": {
        "type": "spinbutton",
        "default": 100,
        "min": 20,
        "max": 300,
        "step": 10,
        "units": "pixels",
        "description": "Graph Height (when override enabled)",
        "tooltip": "Height of each temperature graph (only used when Override Panel Height is enabled)",
        "dependency": "override-panel-height"
    },
    "time-range": {
        "type": "spinbutton",
        "default": 60,
        "min": 10,
        "max": 600,
        "step": 10,
        "units": "seconds",
        "description": "Time Range (X-axis)",
        "tooltip": "Time range to display on the X-axis"
    },
    "sample-rate": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "seconds",
        "description": "Sample Rate",
        "tooltip": "How often to sample temperature readings"
    },
    "cpu-color": {
        "type": "colorchooser",
        "default": "rgba(255,100,100,1)",
        "description": "CPU Graph Color",
        "tooltip": "Color for the CPU temperature line"
    },
    "gpu-color": {
        "type": "colorchooser",
        "default": "rgba(100,255,100,1)",
        "description": "GPU Graph Color",
        "tooltip": "Color for the GPU temperature line"
    },
    "bg-color": {
        "type": "colorchooser",
        "default": "rgba(0,0,0,0.8)",
        "description": "Background Color",
        "tooltip": "Background color for the graphs"
    },
    "grid-color": {
        "type": "colorchooser",
        "default": "rgba(100,100,100,0.5)",
        "description": "Grid Color",
        "tooltip": "Color for the grid lines"
    },
    "use-fahrenheit": {
        "type": "checkbox",
        "default": false,
        "description": "Use Fahrenheit",
        "tooltip": "Display temperature in Fahrenheit instead of Celsius"
    },
    "temp-min": {
        "type": "spinbutton",
        "default": 0,
        "min": -60,
        "max": 212,
        "step": 5,
        "units": "F/C",
        "description": "Minimum Temperature (Y-axis)",
        "tooltip": "Minimum temperature for Y-axis. Enter in Fahrenheit if 'Use Fahrenheit' is checked, otherwise Celsius."
    },
    "temp-max": {
        "type": "spinbutton",
        "default": 100,
        "min": 0,
        "max": 302,
        "step": 5,
        "units": "F/C",
        "description": "Maximum Temperature (Y-axis)",
        "tooltip": "Maximum temperature for Y-axis. Enter in Fahrenheit if 'Use Fahrenheit' is checked, otherwise Celsius."
    },
    "buffer-size": {
        "type": "spinbutton",
        "default": 1000,
        "min": 100,
        "max": 10000,
        "step": 100,
        "units": "readings",
        "description": "History Buffer Size",
        "tooltip": "Number of temperature readings to retain in history (100-10000)"
    }
}